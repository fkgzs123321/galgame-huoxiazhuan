[
  {
    "id": "hope-light-ui-v3",
    "scriptName": "希望之光硬核建卡全包框架",
    "findRegex": "^([\\s\\S]*)$",
    "replaceString": "<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\" />\n    <title>希望之光 - 临终关怀中心</title>\n    <style>\n      /* ========================================\n           CSS 变量主题系统：赛博医疗 / 寂静深海\n           ======================================== */\n      :root {\n        /* 主背景色系 */\n        --hl-bg-base: #020617; /* 极夜蓝 */\n        --hl-bg-panel: rgba(15, 23, 42, 0.75);\n        --hl-bg-panel-solid: rgba(15, 23, 42, 0.95);\n        --hl-bg-overlay: rgba(2, 6, 23, 0.85);\n\n        /* 强调色系 */\n        --hl-primary: #0ea5e9; /* 医疗荧光蓝 */\n        --hl-primary-glow: rgba(14, 165, 233, 0.4);\n\n        --hl-success: #10b981; /* 生命绿 */\n        --hl-warning: #f59e0b; /* 警示黄 */\n        --hl-danger: #ef4444; /* 危急红 */\n        --hl-danger-glow: rgba(239, 68, 68, 0.6);\n        --hl-purple: #8b5cf6; /* 污染/异常紫色 */\n\n        /* 文字色系 */\n        --hl-text-main: #f8fafc;\n        --hl-text-muted: #64748b;\n        --hl-text-accent: #38bdf8;\n\n        /* 边框与阴影 */\n        --hl-border: rgba(14, 165, 233, 0.2);\n        --hl-border-bright: rgba(14, 165, 233, 0.5);\n        --hl-shadow: 0 4px 12px rgba(0, 0, 0, 0.5);\n        --hl-shadow-glow: 0 0 15px var(--hl-primary-glow);\n\n        /* 杂项 */\n        --hl-radius: 8px;\n        --hl-transition-fast: 0.15s ease-out;\n        --hl-transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n      }\n\n      /* ========================================\n           基础包裹器\n           ======================================== */\n      .hl-root-wrapper {\n        position: relative;\n        width: 100%;\n        height: 100%;\n        min-height: 550px;\n        max-height: 85vh;\n        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;\n        background-color: var(--hl-bg-base);\n        color: var(--hl-text-main);\n        border-radius: var(--hl-radius);\n        border: 1px solid var(--hl-border);\n        overflow: hidden;\n        display: flex;\n        flex-direction: column;\n        box-shadow: var(--hl-shadow);\n        background-image: radial-gradient(circle at 50% 0%, rgba(14, 165, 233, 0.1) 0%, transparent 70%);\n      }\n\n      /* CRT 扫描线遮罩 */\n      .hl-root-wrapper::after {\n        content: ' ';\n        display: block;\n        pointer-events: none;\n        position: absolute;\n        top: 0;\n        left: 0;\n        bottom: 0;\n        right: 0;\n        background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%);\n        background-size: 100% 4px;\n        z-index: 999;\n        opacity: 0.6;\n      }\n\n      .hl-root-wrapper * {\n        box-sizing: border-box;\n        scrollbar-width: thin;\n        scrollbar-color: var(--hl-border) transparent;\n      }\n\n      /* 隐藏滚动条 */\n      .hl-scroll::-webkit-scrollbar {\n        width: 4px;\n      }\n      .hl-scroll::-webkit-scrollbar-track {\n        background: transparent;\n      }\n      .hl-scroll::-webkit-scrollbar-thumb {\n        background: var(--hl-border);\n        border-radius: 2px;\n      }\n\n      /* ========================================\n           动画系统\n           ======================================== */\n      @keyframes hl-fade-in {\n        from {\n          opacity: 0;\n          transform: translateY(10px);\n        }\n        to {\n          opacity: 1;\n          transform: translateY(0);\n        }\n      }\n      @keyframes hl-pulse {\n        0%,\n        100% {\n          box-shadow: 0 0 5px var(--hl-primary);\n          opacity: 0.8;\n        }\n        50% {\n          box-shadow: 0 0 20px var(--hl-primary);\n          opacity: 1;\n        }\n      }\n\n      /* ========================================\n           通用表单与控件 (科幻极简风)\n           ======================================== */\n      .hl-glass {\n        background: var(--hl-bg-panel);\n        backdrop-filter: blur(12px);\n        -webkit-backdrop-filter: blur(12px);\n        border: 1px solid var(--hl-border);\n      }\n\n      .hl-label {\n        display: block;\n        font-size: 11px;\n        color: var(--hl-text-muted);\n        margin-bottom: 6px;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n      }\n\n      .hl-input,\n      .hl-select {\n        width: 100%;\n        background: rgba(0, 0, 0, 0.5);\n        border: 1px solid var(--hl-border-bright);\n        color: var(--hl-text-main);\n        padding: 8px 12px;\n        font-family: inherit;\n        font-size: 13px;\n        border-radius: 4px;\n        outline: none;\n        transition: var(--hl-transition-fast);\n      }\n      .hl-input:focus,\n      .hl-select:focus {\n        border-color: var(--hl-primary);\n        box-shadow: 0 0 8px var(--hl-primary-glow);\n        background: rgba(14, 165, 233, 0.05);\n      }\n      .hl-select option {\n        background: var(--hl-bg-base);\n        color: var(--hl-text-main);\n      }\n\n      /* Toggles (开关组件) */\n      .hl-toggle-row {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        padding: 8px 0;\n        border-bottom: 1px dashed var(--hl-border);\n      }\n      .hl-toggle-row:last-child {\n        border-bottom: none;\n      }\n      .hl-toggle-text {\n        display: flex;\n        flex-direction: column;\n        gap: 2px;\n      }\n      .hl-toggle-title {\n        font-size: 13px;\n        color: var(--hl-text-main);\n      }\n      .hl-toggle-desc {\n        font-size: 10px;\n        color: var(--hl-text-muted);\n      }\n      .hl-switch {\n        position: relative;\n        display: inline-block;\n        width: 36px;\n        height: 20px;\n      }\n      .hl-switch input {\n        opacity: 0;\n        width: 0;\n        height: 0;\n      }\n      .hl-slider {\n        position: absolute;\n        cursor: pointer;\n        top: 0;\n        left: 0;\n        right: 0;\n        bottom: 0;\n        background-color: rgba(255, 255, 255, 0.1);\n        transition: 0.3s;\n        border-radius: 20px;\n        border: 1px solid var(--hl-text-muted);\n      }\n      .hl-slider:before {\n        position: absolute;\n        content: '';\n        height: 14px;\n        width: 14px;\n        left: 2px;\n        bottom: 2px;\n        background-color: var(--hl-text-muted);\n        transition: 0.3s;\n        border-radius: 50%;\n      }\n      input:checked + .hl-slider {\n        background-color: var(--hl-primary);\n        border-color: var(--hl-primary);\n        box-shadow: 0 0 10px var(--hl-primary-glow);\n      }\n      input:checked + .hl-slider:before {\n        transform: translateX(16px);\n        background-color: #fff;\n      }\n\n      input.danger-toggle:checked + .hl-slider {\n        background-color: var(--hl-danger);\n        border-color: var(--hl-danger);\n        box-shadow: 0 0 10px var(--hl-danger-glow);\n      }\n      input.purple-toggle:checked + .hl-slider {\n        background-color: var(--hl-purple);\n        border-color: var(--hl-purple);\n        box-shadow: 0 0 10px rgba(139, 92, 246, 0.4);\n      }\n\n      .hl-btn {\n        background: rgba(14, 165, 233, 0.1);\n        color: var(--hl-text-main);\n        border: 1px solid var(--hl-border-bright);\n        padding: 10px 20px;\n        border-radius: 6px;\n        cursor: pointer;\n        font-family: inherit;\n        font-size: 14px;\n        font-weight: bold;\n        transition: var(--hl-transition-fast);\n        text-transform: uppercase;\n        width: 100%;\n      }\n      .hl-btn:hover {\n        border-color: var(--hl-primary);\n        box-shadow: var(--hl-shadow-glow);\n        color: var(--hl-primary);\n        background: rgba(14, 165, 233, 0.2);\n      }\n      .hl-btn:active {\n        transform: scale(0.98);\n      }\n\n      /* ========================================\n           视图 1：开局建卡与设置终端 (Login/Create)\n           ======================================== */\n      .hl-view-login {\n        display: none;\n        flex-direction: column;\n        width: 100%;\n        height: 100%;\n        position: relative;\n        z-index: 10;\n      }\n      .hl-view-login.active {\n        display: flex;\n        animation: hl-fade-in 0.6s ease-out forwards;\n      }\n\n      .hl-creation-header {\n        padding: 16px 20px;\n        background: var(--hl-bg-overlay);\n        border-bottom: 1px solid var(--hl-border);\n        text-align: center;\n      }\n      .hl-creation-title {\n        font-size: 18px;\n        color: var(--hl-primary);\n        margin: 0 0 4px 0;\n        letter-spacing: 2px;\n        text-shadow: 0 0 10px var(--hl-primary-glow);\n      }\n      .hl-creation-subtitle {\n        font-size: 11px;\n        color: var(--hl-text-muted);\n        margin: 0;\n      }\n\n      .hl-creation-body {\n        flex: 1;\n        padding: 20px;\n        overflow-y: auto;\n        display: flex;\n        flex-direction: column;\n        gap: 20px;\n      }\n\n      .hl-form-section {\n        background: rgba(0, 0, 0, 0.3);\n        border: 1px solid var(--hl-border);\n        border-radius: 6px;\n        padding: 16px;\n        position: relative;\n      }\n      .hl-form-section::before {\n        content: attr(data-title);\n        position: absolute;\n        top: -9px;\n        left: 12px;\n        background: var(--hl-bg-base);\n        padding: 0 6px;\n        font-size: 10px;\n        color: var(--hl-primary);\n        font-weight: bold;\n      }\n\n      .hl-form-grid {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 12px;\n      }\n      .hl-form-full {\n        grid-column: 1 / -1;\n        margin-top: 10px;\n      }\n\n      .hl-creation-footer {\n        padding: 16px 20px;\n        background: var(--hl-bg-panel-solid);\n        border-top: 1px solid var(--hl-border);\n      }\n\n      /* ========================================\n           视图 2：主控台 (Main Game)\n           ======================================== */\n      .hl-view-main {\n        display: none;\n        flex-direction: column;\n        height: 100%;\n        position: relative;\n        z-index: 10;\n      }\n      .hl-view-main.active {\n        display: flex;\n        animation: hl-fade-in 0.5s ease-out forwards;\n      }\n\n      .hl-navbar {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        padding: 10px 16px;\n        background: var(--hl-bg-panel-solid);\n        border-bottom: 1px solid var(--hl-border);\n      }\n      .hl-nav-left {\n        display: flex;\n        align-items: center;\n        gap: 8px;\n        font-size: 12px;\n        color: var(--hl-primary);\n      }\n      .hl-dash-dot {\n        width: 6px;\n        height: 6px;\n        border-radius: 50%;\n        background: var(--hl-success);\n        box-shadow: 0 0 8px var(--hl-success);\n      }\n      .hl-nav-right {\n        font-size: 11px;\n        color: var(--hl-text-muted);\n      }\n\n      .hl-dashboard {\n        display: grid;\n        grid-template-columns: repeat(4, 1fr);\n        gap: 1px;\n        background: var(--hl-border);\n        border-bottom: 1px solid var(--hl-border);\n      }\n      .hl-dash-item {\n        background: var(--hl-bg-panel);\n        padding: 10px 8px;\n        text-align: center;\n        display: flex;\n        flex-direction: column;\n        gap: 4px;\n      }\n      .hl-dash-label {\n        font-size: 9px;\n        color: var(--hl-text-muted);\n        text-transform: uppercase;\n      }\n      .hl-dash-val {\n        font-size: 16px;\n        font-weight: bold;\n        color: var(--hl-text-main);\n      }\n\n      .hl-val-danger {\n        color: var(--hl-danger);\n        text-shadow: 0 0 8px var(--hl-danger-glow);\n      }\n      .hl-val-warning {\n        color: var(--hl-warning);\n      }\n      .hl-val-success {\n        color: var(--hl-success);\n      }\n      .hl-val-info {\n        color: var(--hl-primary);\n        text-shadow: 0 0 8px var(--hl-primary-glow);\n      }\n\n      .hl-content-box {\n        flex: 1;\n        padding: 16px 20px;\n        overflow-y: auto;\n        position: relative;\n        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', sans-serif;\n        font-size: 14px;\n        line-height: 1.7;\n        color: #d1d5db;\n      }\n      .hl-hidden-sys {\n        display: none !important;\n      }\n\n      .hl-action-pad {\n        background: var(--hl-bg-panel-solid);\n        border-top: 1px solid var(--hl-border);\n        padding: 12px 16px;\n      }\n      .hl-action-grid {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: 8px;\n      }\n      .hl-btn-sm {\n        padding: 8px 12px;\n        font-size: 12px;\n      }\n      @media (max-width: 480px) {\n        .hl-action-grid {\n          grid-template-columns: repeat(2, 1fr);\n        }\n      }\n    </style>\n  </head>\n  <body>\n    <div class=\"hl-root-wrapper\" id=\"hl-app\">\n      <!-- ==============================================\n         视图一：系统开局 - 人物建立与配置终端\n         ============================================== -->\n      <div class=\"hl-view-login hl-scroll\" id=\"hl-view-login\">\n        <div class=\"hl-creation-header\">\n          <h1 class=\"hl-creation-title\">希望之光 • 档案中心</h1>\n          <p class=\"hl-creation-subtitle\">STAFF REGISTRATION & DIRECTIVE CONFIG</p>\n        </div>\n\n        <div class=\"hl-creation-body\">\n          <!-- 1. 基础档案 -->\n          <div class=\"hl-form-section\" data-title=\"[01] 基础档案录入\">\n            <div class=\"hl-form-grid\">\n              <div>\n                <label class=\"hl-label\">干员代号 (Name)</label>\n                <!-- 默认填充ST的user宏，供回退或者作为提示使用，但不在JS直接取解析前的花括号 -->\n                <input type=\"text\" id=\"hl-form-name\" class=\"hl-input\" placeholder=\"输入您的姓名\" />\n              </div>\n              <div>\n                <label class=\"hl-label\">生理性别 (Sex)</label>\n                <select id=\"hl-form-gender\" class=\"hl-select\">\n                  <option value=\"男性\">男性</option>\n                  <option value=\"女性\">女性</option>\n                  <option value=\"保密\">其他/保密</option>\n                </select>\n              </div>\n              <div class=\"hl-form-full\">\n                <label class=\"hl-label\">背景特质 (Background Trait)</label>\n                <select id=\"hl-form-trait\" class=\"hl-select\">\n                  <option value=\"医学尖子\">医学尖子 (初始健康值更高，精通医疗检定)</option>\n                  <option value=\"高敏体质\">高敏体质 (容易掉SAN，但更早发现异常)</option>\n                  <option value=\"黑市关系\">黑市关系 (初始金钱更多，可购买违禁药物)</option>\n                  <option value=\"冷酷无情\">冷酷无情 (SAN值掉落减慢，病人好感下降加快)</option>\n                  <option value=\"神秘学徒\">神秘学徒 (能进行污染仪式对抗异常)</option>\n                </select>\n              </div>\n            </div>\n          </div>\n\n          <!-- 2. 环境难度参数 -->\n          <div class=\"hl-form-section\" data-title=\"[02] 环境与难度配置\">\n            <div class=\"hl-form-grid\">\n              <div>\n                <label class=\"hl-label\">合同难度 (Difficulty)</label>\n                <select id=\"hl-form-diff\" class=\"hl-select\">\n                  <option value=\"见习护工(简单)\">初级护工 (简单：物资质充沛，异常较温和)</option>\n                  <option value=\"正式干员(普通)\" selected>正式干员 (普通：标准的绝望与希望)</option>\n                  <option value=\"夜班死神(困难)\">夜班死神 (困难：极度缺乏经费，疯狂的夜晚)</option>\n                </select>\n              </div>\n              <div>\n                <label class=\"hl-label\">主线侧重倾向 (Focus)</label>\n                <select id=\"hl-form-focus\" class=\"hl-select\">\n                  <option value=\"拯救患者优先\">治病救人 (追求治愈率与人性)</option>\n                  <option value=\"探索世界观优先\">调查黑幕 (机构背后的恐怖阴谋)</option>\n                  <option value=\"生存敛财优先\">捞钱苟活 (冷血赚取经费并活下去)</option>\n                </select>\n              </div>\n            </div>\n          </div>\n\n          <!-- 3. 安全协议与 DLC 扩展 -->\n          <div class=\"hl-form-section\" data-title=\"[03] 系统安全阀 & 扩展包\">\n            <!-- NSFW -->\n            <div class=\"hl-toggle-row\">\n              <div class=\"hl-toggle-text\">\n                <span class=\"hl-toggle-title\">解除 NSFW 合规限制</span>\n                <span class=\"hl-toggle-desc\">允许出现极端暴力、血腥、身体异变或成人向/越轨情节描写。</span>\n              </div>\n              <label class=\"hl-switch\">\n                <input type=\"checkbox\" id=\"hl-form-nsfw\" class=\"danger-toggle\" />\n                <span class=\"hl-slider\"></span>\n              </label>\n            </div>\n            <!-- DLC 1 -->\n            <div class=\"hl-toggle-row\">\n              <div class=\"hl-toggle-text\">\n                <span class=\"hl-toggle-title\">扩展池：[深渊低语]</span>\n                <span class=\"hl-toggle-desc\">开启克苏鲁风格的心智污染事件、不可名状之物下潜。</span>\n              </div>\n              <label class=\"hl-switch\">\n                <input type=\"checkbox\" id=\"hl-form-dlc1\" class=\"purple-toggle\" checked />\n                <span class=\"hl-slider\"></span>\n              </label>\n            </div>\n            <!-- DLC 2 -->\n            <div class=\"hl-toggle-row\">\n              <div class=\"hl-toggle-text\">\n                <span class=\"hl-toggle-title\">扩展池：[灰色地带]</span>\n                <span class=\"hl-toggle-desc\">开启器官倒卖、黑市医生串门、违规药品地下交易网。</span>\n              </div>\n              <label class=\"hl-switch\">\n                <input type=\"checkbox\" id=\"hl-form-dlc2\" checked />\n                <span class=\"hl-slider\"></span>\n              </label>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"hl-creation-footer\">\n          <button class=\"hl-btn\" onclick=\"HL_App.submitCreation()\">[ 确立档案并联机 / START ]</button>\n        </div>\n      </div>\n\n      <!-- ==============================================\n         视图二：主控台 (正文与日常操作)\n         ============================================== -->\n      <div class=\"hl-view-main\" id=\"hl-view-main\">\n        <div class=\"hl-navbar\">\n          <div class=\"hl-nav-left\">\n            <div class=\"hl-dash-dot\"></div>\n            <span>HL-OS / NODE_ACT_ACTIVE</span>\n          </div>\n          <div class=\"hl-nav-right\">\n            <span id=\"hl-time\">{{getvar::当前时间|未知}}</span>\n          </div>\n        </div>\n\n        <div class=\"hl-dashboard\">\n          <div class=\"hl-dash-item\">\n            <span class=\"hl-dash-label\">HP 健康</span>\n            <span class=\"hl-dash-val hl-auto-color\" data-type=\"hp\">{{getvar::健康值|100}}</span>\n          </div>\n          <div class=\"hl-dash-item\">\n            <span class=\"hl-dash-label\">SAN 理智</span>\n            <span class=\"hl-dash-val hl-auto-color\" data-type=\"san\">{{getvar::理智值|100}}</span>\n          </div>\n          <div class=\"hl-dash-item\">\n            <span class=\"hl-dash-label\">经费余额</span>\n            <span class=\"hl-dash-val hl-val-info\">${{getvar::经费|0}}</span>\n          </div>\n          <div class=\"hl-dash-item\">\n            <span class=\"hl-dash-label\">合规审计</span>\n            <span class=\"hl-dash-val\">{{getvar::合规状态|正常}}</span>\n          </div>\n        </div>\n\n        <div class=\"hl-content-box hl-scroll\" id=\"hl-content\">\n          <div id=\"hl-injected-text\">\n            $1\n          </div>\n        </div>\n\n        <div class=\"hl-action-pad\">\n          <div class=\"hl-action-grid\">\n            <button class=\"hl-btn hl-btn-sm\" onclick=\"HL_App.dispatch('【基础护理】')\">💊 基础护理</button>\n            <button class=\"hl-btn hl-btn-sm\" onclick=\"HL_App.dispatch('【心理辅导】')\">💬 心理辅导</button>\n            <button class=\"hl-btn hl-btn-sm\" onclick=\"HL_App.dispatch('【强制收容】')\">🛡️ 强制约束</button>\n            <button class=\"hl-btn hl-btn-sm\" onclick=\"HL_App.dispatch('【信息检索】')\">📋 查阅档案</button>\n            <button class=\"hl-btn hl-btn-sm\" onclick=\"HL_App.dispatch('【清理尸库】')\">🧽 病房特清</button>\n            <button class=\"hl-btn hl-btn-sm danger\" onclick=\"HL_App.dispatch('【注入镇静】')\">💉 紧急镇静</button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <script>\n      /**\n       * 希望之光终端应用引擎 (Hope Light OS Engine)\n       * v3.0 - 建卡设定与智能路由\n       */\n      const HL_App = {\n        init() {\n          this.cacheDOM();\n\n          // 尝试提取ST内建的用户名宏来预填姓名槽\n          const userMacro = '{{user}}';\n          if (userMacro && userMacro !== '{' + '{user}}') {\n            const nameInput = document.getElementById('hl-form-name');\n            if (nameInput && !nameInput.value) {\n              nameInput.value = userMacro;\n            }\n          }\n\n          this.routeView();\n          this.bindAutoColors();\n          this.cleanUpInjectedText();\n        },\n\n        cacheDOM() {\n          this.viewLogin = document.getElementById('hl-view-login');\n          this.viewMain = document.getElementById('hl-view-main');\n          this.contentDiv = document.getElementById('hl-injected-text');\n        },\n\n        // 判断当前是不是开局第一句：如果没有上文或者包含了【终端未激活】\n        routeView() {\n          if (!this.contentDiv) return;\n          const text = this.contentDiv.innerText || '';\n          const isUninitialized = text.includes('【终端未激活】') || text.includes('希望之光');\n\n          if (isUninitialized && text.length < 600) {\n            this.switchToLogin();\n            this.contentDiv.style.display = 'none';\n          } else {\n            this.switchToMain();\n          }\n        },\n\n        switchToLogin() {\n          this.viewLogin.classList.add('active');\n          this.viewMain.classList.remove('active');\n        },\n\n        switchToMain() {\n          this.viewLogin.classList.remove('active');\n          this.viewMain.classList.add('active');\n          this.contentDiv.style.display = 'block';\n          const contentBox = document.getElementById('hl-content');\n          if (contentBox) setTimeout(() => (contentBox.scrollTop = contentBox.scrollHeight), 100);\n        },\n\n        // 建表提交：收集各种字段拼装发送给 LLM\n        submitCreation() {\n          const name = document.getElementById('hl-form-name').value || '无名氏';\n          const gender = document.getElementById('hl-form-gender').value;\n          const trait = document.getElementById('hl-form-trait').value;\n          const diff = document.getElementById('hl-form-diff').value;\n          const focus = document.getElementById('hl-form-focus').value;\n\n          const nsfw = document.getElementById('hl-form-nsfw').checked ? '开启解禁' : '严格合规(禁止此类内容)';\n          const dlc1 = document.getElementById('hl-form-dlc1').checked ? '已装载' : '未装载';\n          const dlc2 = document.getElementById('hl-form-dlc2').checked ? '已装载' : '未装载';\n\n          // 格式化为大模型引导语 (系统外联指令)\n          const systemPrompt =\n            `【系统指令：新档建立完毕，请主控AI据此生成第一天环境与事件】\\n` +\n            `# 玩家档案 \\n姓名：${name} | 性别：${gender} | 背景特质：[${trait}]\\n` +\n            `# 游戏模式 \\n难度：${diff} | 剧情倾向：${focus}\\n` +\n            `# 系统规则与模组 \\nNSFW表现：${nsfw} | [深渊低语]DLC：${dlc1} | [灰色地带]DLC：${dlc2}\\n\\n` +\n            `请作为《希望之光》游戏系统或首位分配给该护工的患者，针对上述设定给出第一夜开局回复。`;\n\n          this.switchToMain();\n          this.dispatch(systemPrompt);\n        },\n\n        bindAutoColors() {\n          const nodes = document.querySelectorAll('.hl-auto-color');\n          nodes.forEach(node => {\n            const type = node.getAttribute('data-type');\n            const match = node.innerText.match(/\\d+/);\n            if (!match) return;\n\n            const val = parseInt(match[0], 10);\n            node.classList.remove('hl-val-danger', 'hl-val-warning', 'hl-val-success');\n\n            if (type === 'hp') {\n              if (val < 35) node.classList.add('hl-val-danger');\n              else if (val < 70) node.classList.add('hl-val-warning');\n              else node.classList.add('hl-val-success');\n            } else if (type === 'san') {\n              if (val < 40) node.classList.add('hl-val-danger');\n              else if (val < 75) node.classList.add('hl-val-warning');\n              else node.classList.add('hl-val-success');\n            }\n          });\n        },\n\n        cleanUpInjectedText() {\n          if (!this.contentDiv) return;\n          let innerHTML = this.contentDiv.innerHTML;\n          innerHTML = innerHTML.replace(\n            /<UpdateVariable[\\s\\S]*?>[\\s\\S]*?<\\/UpdateVariable>/gi,\n            '<div class=\"hl-hidden-sys\">$&</div>',\n          );\n          innerHTML = innerHTML.replace(/\\[route\\][\\s\\S]*?\\n/gi, '<div class=\"hl-hidden-sys\">$&</div>');\n          this.contentDiv.innerHTML = innerHTML;\n        },\n\n        dispatch(cmd) {\n          console.log('[HL] Send =>', cmd);\n          if (typeof window !== 'undefined' && window.SlashCommandParser) {\n            try {\n              window.SlashCommandParser.executeSlash(`/send ${cmd}`);\n              return;\n            } catch (e) {\n              console.warn('[HL] SC failed, fallback DOM.', e);\n            }\n          }\n\n          const textarea = document.getElementById('send_textarea');\n          const sendBtn = document.getElementById('send_but');\n          if (textarea && sendBtn) {\n            const nativeInputValueSetter = Object.getOwnPropertyDescriptor(\n              window.HTMLTextAreaElement.prototype,\n              'value',\n            ).set;\n            nativeInputValueSetter.call(textarea, cmd);\n            textarea.dispatchEvent(new Event('input', { bubbles: true }));\n            setTimeout(() => sendBtn.click(), 50);\n          } else {\n            navigator.clipboard.writeText(cmd).then(() => {\n              alert(`命令已复制到剪贴板，请手动发送: \\n${cmd}`);\n            });\n          }\n        },\n      };\n\n      setTimeout(() => HL_App.init(), 50);\n    </script>\n  </body>\n</html>\n",
    "trimStrings": [],
    "placement": [
      1,
      2
    ],
    "disabled": false,
    "markdownOnly": false,
    "promptOnly": false,
    "runOnEdit": true,
    "runOnRead": true,
    "runOnActivity": false,
    "color": "rgba(139, 92, 246, 1)",
