[
  {
    "id": "hope-light-ui-v2",
    "scriptName": "希望之光沉浸式全包框架",
    "findRegex": "^([\\s\\S]*)$",
    "replaceString": "<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\" />\n    <title>希望之光 - 临终关怀中心</title>\n    <style>\n      /* ========================================\n           CSS 变量主题系统：赛博医疗 / 寂静深海\n           ======================================== */\n      :root {\n        /* 主背景色系 */\n        --hl-bg-base: #020617; /* 极夜蓝 */\n        --hl-bg-panel: rgba(15, 23, 42, 0.75);\n        --hl-bg-panel-solid: rgba(15, 23, 42, 0.95);\n        --hl-bg-overlay: rgba(2, 6, 23, 0.6);\n\n        /* 强调色系 */\n        --hl-primary: #0ea5e9; /* 医疗荧光蓝 */\n        --hl-primary-glow: rgba(14, 165, 233, 0.4);\n        --hl-primary-dark: #0369a1;\n\n        --hl-success: #10b981; /* 生命绿 */\n        --hl-warning: #f59e0b; /* 警示黄 */\n        --hl-danger: #ef4444; /* 危急红 */\n        --hl-danger-glow: rgba(239, 68, 68, 0.6);\n\n        /* 文字色系 */\n        --hl-text-main: #f8fafc;\n        --hl-text-muted: #64748b;\n        --hl-text-accent: #38bdf8;\n\n        /* 边框与阴影 */\n        --hl-border: rgba(14, 165, 233, 0.2);\n        --hl-border-bright: rgba(14, 165, 233, 0.5);\n        --hl-shadow: 0 4px 12px rgba(0, 0, 0, 0.5);\n        --hl-shadow-glow: 0 0 15px var(--hl-primary-glow);\n\n        /* 杂项 */\n        --hl-radius: 12px;\n        --hl-transition-fast: 0.15s ease-out;\n        --hl-transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n      }\n\n      /* ========================================\n           基础与包裹器层 (防止污染 ST 原生样式)\n           ======================================== */\n      .hl-root-wrapper {\n        position: relative;\n        width: 100%;\n        height: 100%;\n        min-height: 500px;\n        max-height: 80vh; /* 适配酒馆气泡 */\n        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;\n        background-color: var(--hl-bg-base);\n        color: var(--hl-text-main);\n        border-radius: var(--hl-radius);\n        border: 1px solid var(--hl-border);\n        overflow: hidden;\n        display: flex;\n        flex-direction: column;\n        box-shadow: var(--hl-shadow);\n        transform: translateZ(0); /* 开启硬件加速 */\n\n        /* 医疗设备的横扫渐变底纹 */\n        background-image: radial-gradient(circle at 50% 0%, rgba(14, 165, 233, 0.1) 0%, transparent 70%);\n      }\n\n      /* CRT 扫描线遮罩 */\n      .hl-root-wrapper::after {\n        content: ' ';\n        display: block;\n        position: absolute;\n        top: 0;\n        left: 0;\n        bottom: 0;\n        right: 0;\n        background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%);\n        background-size: 100% 4px;\n        z-index: 999;\n        pointer-events: none;\n        opacity: 0.5;\n      }\n\n      .hl-root-wrapper * {\n        box-sizing: border-box;\n        scrollbar-width: thin;\n        scrollbar-color: var(--hl-border) transparent;\n      }\n\n      /* 隐藏滚动条 */\n      .hl-scroll::-webkit-scrollbar {\n        width: 6px;\n      }\n      .hl-scroll::-webkit-scrollbar-track {\n        background: transparent;\n      }\n      .hl-scroll::-webkit-scrollbar-thumb {\n        background: var(--hl-border);\n        border-radius: 3px;\n      }\n\n      /* ========================================\n           动画系统\n           ======================================== */\n      @keyframes hl-fade-in {\n        from {\n          opacity: 0;\n          transform: translateY(10px);\n        }\n        to {\n          opacity: 1;\n          transform: translateY(0);\n        }\n      }\n      @keyframes hl-pulse {\n        0%,\n        100% {\n          box-shadow: 0 0 5px var(--hl-primary);\n          opacity: 0.8;\n        }\n        50% {\n          box-shadow: 0 0 20px var(--hl-primary);\n          opacity: 1;\n        }\n      }\n      @keyframes hl-crt-flicker {\n        0% {\n          opacity: 0.95;\n        }\n        5% {\n          opacity: 0.85;\n        }\n        10% {\n          opacity: 0.95;\n        }\n        15% {\n          opacity: 1;\n        }\n        100% {\n          opacity: 1;\n        }\n      }\n      @keyframes hl-ecg-line {\n        0% {\n          width: 0;\n          opacity: 1;\n        }\n        50% {\n          width: 100%;\n          opacity: 0.5;\n        }\n        100% {\n          width: 0;\n          left: 100%;\n          opacity: 0;\n        }\n      }\n\n      /* ========================================\n           通用功能类\n           ======================================== */\n      .hl-glass {\n        background: var(--hl-bg-panel);\n        backdrop-filter: blur(12px);\n        -webkit-backdrop-filter: blur(12px);\n        border: 1px solid var(--hl-border);\n      }\n\n      .hl-btn {\n        background: transparent;\n        color: var(--hl-text-main);\n        border: 1px solid var(--hl-border);\n        padding: 8px 16px;\n        border-radius: 6px;\n        cursor: pointer;\n        font-family: inherit;\n        font-size: 13px;\n        font-weight: bold;\n        letter-spacing: 1px;\n        transition: var(--hl-transition-fast);\n        position: relative;\n        overflow: hidden;\n        text-transform: uppercase;\n      }\n\n      .hl-btn::before {\n        content: '';\n        position: absolute;\n        top: 0;\n        left: -100%;\n        width: 100%;\n        height: 100%;\n        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);\n        transition: all 0.4s ease;\n      }\n\n      .hl-btn:hover {\n        border-color: var(--hl-primary);\n        box-shadow: var(--hl-shadow-glow);\n        color: var(--hl-primary);\n        background: rgba(14, 165, 233, 0.1);\n      }\n\n      .hl-btn:hover::before {\n        left: 100%;\n      }\n\n      .hl-btn:active {\n        transform: scale(0.97);\n      }\n\n      .hl-btn.danger {\n        border-color: var(--hl-danger);\n        color: var(--hl-danger);\n      }\n      .hl-btn.danger:hover {\n        background: rgba(239, 68, 68, 0.1);\n        box-shadow: 0 0 15px var(--hl-danger-glow);\n      }\n\n      /* ========================================\n           视图 1：开局终端屏幕 (Login)\n           ======================================== */\n      .hl-view-login {\n        display: none;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n        height: 100%;\n        padding: 40px 20px;\n        position: relative;\n        z-index: 10;\n      }\n      .hl-view-login.active {\n        display: flex;\n        animation: hl-fade-in 0.8s ease-out forwards;\n      }\n\n      .hl-logo-box {\n        text-align: center;\n        margin-bottom: 40px;\n      }\n      .hl-logo-icon {\n        font-size: 56px;\n        color: var(--hl-primary);\n        text-shadow: 0 0 20px var(--hl-primary);\n        margin-bottom: 20px;\n        display: inline-block;\n        animation: hl-pulse 3s infinite;\n      }\n      .hl-title {\n        font-size: 28px;\n        font-weight: bold;\n        color: var(--hl-text-main);\n        letter-spacing: 4px;\n        margin: 0 0 10px 0;\n        text-transform: uppercase;\n      }\n      .hl-subtitle {\n        font-size: 12px;\n        color: var(--hl-primary);\n        letter-spacing: 2px;\n        margin: 0;\n        opacity: 0.8;\n      }\n\n      .hl-terminal-box {\n        width: 100%;\n        max-width: 480px;\n        background: rgba(0, 0, 0, 0.4);\n        border: 1px solid var(--hl-border);\n        border-radius: 8px;\n        padding: 24px;\n        margin-bottom: 30px;\n        font-size: 13px;\n        line-height: 1.8;\n        color: var(--hl-text-muted);\n        text-align: left;\n        position: relative;\n      }\n\n      .hl-terminal-box::before {\n        content: 'SYSTEM LOG //';\n        position: absolute;\n        top: -10px;\n        left: 15px;\n        background: var(--hl-bg-base);\n        padding: 0 10px;\n        font-size: 11px;\n        color: var(--hl-primary);\n      }\n\n      .hl-terminal-text span.highlight {\n        color: var(--hl-text-main);\n        font-weight: bold;\n      }\n      .hl-terminal-text span.alert {\n        color: var(--hl-warning);\n      }\n\n      .hl-btn-start {\n        padding: 14px 48px;\n        font-size: 16px;\n        letter-spacing: 2px;\n        border-radius: 4px;\n        background: rgba(14, 165, 233, 0.1);\n        border: 1px solid var(--hl-primary);\n        animation: hl-crt-flicker 5s infinite;\n      }\n\n      /* ========================================\n           视图 2：主副控台区 (Main)\n           ======================================== */\n      .hl-view-main {\n        display: none;\n        flex-direction: column;\n        height: 100%;\n        position: relative;\n        z-index: 10;\n      }\n      .hl-view-main.active {\n        display: flex;\n        animation: hl-fade-in 0.5s ease-out forwards;\n      }\n\n      /* 顶部导航与时间 */\n      .hl-navbar {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        padding: 10px 16px;\n        background: var(--hl-bg-panel-solid);\n        border-bottom: 1px solid var(--hl-border);\n      }\n      .hl-nav-left {\n        display: flex;\n        align-items: center;\n        gap: 10px;\n        font-size: 13px;\n        color: var(--hl-primary);\n      }\n      .hl-status-dot {\n        width: 6px;\n        height: 6px;\n        border-radius: 50%;\n        background: var(--hl-success);\n        box-shadow: 0 0 8px var(--hl-success);\n      }\n      .hl-nav-right {\n        font-size: 12px;\n        color: var(--hl-text-muted);\n      }\n\n      /* 核心状态监测仪 (仪表盘) */\n      .hl-dashboard {\n        display: grid;\n        grid-template-columns: repeat(4, 1fr);\n        gap: 1px;\n        background: var(--hl-border);\n        border-bottom: 1px solid var(--hl-border);\n      }\n      .hl-dash-item {\n        background: var(--hl-bg-panel);\n        padding: 12px 10px;\n        text-align: center;\n        display: flex;\n        flex-direction: column;\n        gap: 4px;\n        transition: var(--hl-transition-normal);\n      }\n      .hl-dash-item:hover {\n        background: rgba(14, 165, 233, 0.1);\n      }\n      .hl-dash-label {\n        font-size: 10px;\n        color: var(--hl-text-muted);\n        text-transform: uppercase;\n        letter-spacing: 1px;\n      }\n      .hl-dash-val {\n        font-size: 18px;\n        font-weight: bold;\n        color: var(--hl-text-main);\n      }\n\n      /* 状态阈值颜色控制类 */\n      .hl-val-danger {\n        color: var(--hl-danger);\n        text-shadow: 0 0 8px var(--hl-danger-glow);\n      }\n      .hl-val-warning {\n        color: var(--hl-warning);\n      }\n      .hl-val-success {\n        color: var(--hl-success);\n      }\n      .hl-val-info {\n        color: var(--hl-primary);\n        text-shadow: 0 0 8px var(--hl-primary-glow);\n      }\n\n      /* 正文区 (AI 生成内容接管区) */\n      .hl-content-box {\n        flex: 1;\n        padding: 20px;\n        overflow-y: auto;\n        position: relative;\n        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', sans-serif;\n        font-size: 15px;\n        line-height: 1.8;\n        color: #d1d5db;\n      }\n\n      .hl-content-box::before {\n        content: 'BODY_LOG_STREAM //';\n        display: block;\n        font-family: ui-monospace, monospace;\n        font-size: 10px;\n        color: var(--hl-border-bright);\n        margin-bottom: 16px;\n        opacity: 0.5;\n      }\n\n      .hl-content-box p {\n        margin-top: 0;\n        margin-bottom: 1em;\n      }\n\n      /* 将一些系统标签强制隐藏 */\n      .hl-hidden-sys {\n        display: none !important;\n      }\n\n      /* 底部动作面板 */\n      .hl-action-pad {\n        background: var(--hl-bg-panel-solid);\n        border-top: 1px solid var(--hl-border);\n        padding: 16px;\n        display: flex;\n        flex-direction: column;\n        gap: 12px;\n      }\n      .hl-action-pad-head {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        font-size: 11px;\n        color: var(--hl-text-muted);\n      }\n      .hl-action-grid {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: 8px;\n      }\n      @media (max-width: 480px) {\n        .hl-action-grid {\n          grid-template-columns: repeat(2, 1fr);\n        }\n      }\n\n      /* 动作面板上的动态心电图线装饰 */\n      .hl-dec-line {\n        position: absolute;\n        top: 0;\n        left: 0;\n        height: 1px;\n        background: var(--hl-primary);\n        box-shadow: 0 0 5px var(--hl-primary);\n        animation: hl-ecg-line 3s infinite linear;\n      }\n    </style>\n  </head>\n  <body>\n    <div class=\"hl-root-wrapper\" id=\"hl-app\">\n      <!-- ==============================================\n         视图一：系统登入界面 (登录/免责声明)\n         ============================================== -->\n      <div class=\"hl-view-login\" id=\"hl-view-login\">\n        <div class=\"hl-logo-box\">\n          <div class=\"hl-logo-icon\">⚕️</div>\n          <h1 class=\"hl-title\">希望之光</h1>\n          <p class=\"hl-subtitle\">TERMINAL CONNECTION ESTABLISHED</p>\n        </div>\n\n        <div class=\"hl-terminal-box\">\n          <div class=\"hl-terminal-text\">\n            <p>> 欢迎接入「希望之光」全息监护网络。</p>\n            <p>> 检测到员工生物特征：<span class=\"highlight\">{{user}}</span></p>\n            <p>\n              >\n              <span class=\"alert\">警告：</span> 本机构实施末端异常收容与临终关怀，护理过程中可能伴发严重的心智污染现象。\n            </p>\n            <p>\n              > 协议验证：请时刻监控自身的 <span class=\"highlight\">SAN值(理智)</span>，遵守\n              <span class=\"highlight\">合规审查</span>，擅自越权将导致抹杀式遣返。\n            </p>\n          </div>\n        </div>\n\n        <button class=\"hl-btn hl-btn-start\" onclick=\"HL_App.startGame()\">[ 确认许可 / 启动终端 ]</button>\n      </div>\n\n      <!-- ==============================================\n         视图二：主控台 (正文与日常操作)\n         ============================================== -->\n      <div class=\"hl-view-main\" id=\"hl-view-main\">\n        <!-- Navbar -->\n        <div class=\"hl-navbar\">\n          <div class=\"hl-nav-left\">\n            <div class=\"hl-status-dot\"></div>\n            <span>HL-OS / NODE_ACT_ACTIVE</span>\n          </div>\n          <div class=\"hl-nav-right\">TIME: <span id=\"hl-time\">{{getvar::当前时间|未知}}</span></div>\n        </div>\n\n        <!-- 状态监测仪 / HUD Dashboard -->\n        <div class=\"hl-dashboard\">\n          <div class=\"hl-dash-item\">\n            <span class=\"hl-dash-label\">健康体征</span>\n            <!-- 通过 data-type 标记，以便 JS 自动提取数值做阈值判断 -->\n            <span class=\"hl-dash-val hl-auto-color\" data-type=\"hp\" id=\"hl-hp\">{{getvar::健康值|100}}</span>\n          </div>\n          <div class=\"hl-dash-item\">\n            <span class=\"hl-dash-label\">精神理智</span>\n            <span class=\"hl-dash-val hl-auto-color\" data-type=\"san\" id=\"hl-san\">{{getvar::理智值|100}}</span>\n          </div>\n          <div class=\"hl-dash-item\">\n            <span class=\"hl-dash-label\">项目经费</span>\n            <span class=\"hl-dash-val hl-val-info\" id=\"hl-money\">${{getvar::经费|0}}</span>\n          </div>\n          <div class=\"hl-dash-item\">\n            <span class=\"hl-dash-label\">合规审计</span>\n            <span class=\"hl-dash-val\" id=\"hl-comp\">{{getvar::合规状态|正常}}</span>\n          </div>\n        </div>\n\n        <!-- 滚动的原文内容区 -->\n        <div class=\"hl-content-box hl-scroll\" id=\"hl-content\">\n          <div id=\"hl-injected-text\">\n            $1\n          </div>\n        </div>\n\n        <!-- 底部快捷指令板 -->\n        <div class=\"hl-action-pad\">\n          <div style=\"position: relative\"><div class=\"hl-dec-line\"></div></div>\n          <div class=\"hl-action-pad-head\">\n            <span>[ 授权动作池 ]</span>\n            <span id=\"hl-ui-status\" style=\"color: var(--hl-success)\">终端链接稳定</span>\n          </div>\n          <div class=\"hl-action-grid\">\n            <button class=\"hl-btn\" onclick=\"HL_App.dispatch('【基础护理】')\">💊 基础护理</button>\n            <button class=\"hl-btn\" onclick=\"HL_App.dispatch('【心理辅导】')\">💬 心理辅导</button>\n            <button class=\"hl-btn\" onclick=\"HL_App.dispatch('【强制收容】')\">🛡️ 强制约束</button>\n            <button class=\"hl-btn\" onclick=\"HL_App.dispatch('【信息检索】')\">📋 查阅档案</button>\n            <button class=\"hl-btn\" onclick=\"HL_App.dispatch('【系统商城】')\">🛒 物质补给</button>\n            <button class=\"hl-btn danger\" onclick=\"HL_App.dispatch('【呼叫救援】')\">🚨 危机警报</button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <script>\n      /**\n       * 希望之光终端应用引擎 (Hope Light OS Engine)\n       * v2.0 - 沉浸式单页架构\n       */\n      const HL_App = {\n        // 1. 初始化引擎\n        init() {\n          console.log('[HL_App] System initializing...');\n          this.cacheDOM();\n          this.routeView();\n          this.bindAutoColors();\n          this.cleanUpInjectedText(); // 清洗 ST 的系统层宏\n        },\n\n        // 2. 缓存 DOM\n        cacheDOM() {\n          this.viewLogin = document.getElementById('hl-view-login');\n          this.viewMain = document.getElementById('hl-view-main');\n          this.contentDiv = document.getElementById('hl-injected-text');\n          this.uiStatus = document.getElementById('hl-ui-status');\n        },\n\n        // 3. 页面路由 (决定展示登录页还是监控台)\n        routeView() {\n          if (!this.contentDiv) return;\n          const text = this.contentDiv.innerText || '';\n\n          // 开局检测法则：如果没有实际下文，或者专门发了终端未激活的标签，进入 Login\n          // 这里为了适配性，如果 {{getvar::健康值|100}} 这种模板甚至没被 ST 替换掉，说明还没完全开始游戏\n          const isUninitialized = text.includes('【终端未激活】') || text.includes('希望之光');\n\n          // 由于每次 ST 返回都会重绘，我们针对当前区块进行渲染\n          if (isUninitialized && text.length < 500) {\n            this.switchToLogin();\n            // 隐藏原本的正文，保持清爽\n            this.contentDiv.style.display = 'none';\n          } else {\n            this.switchToMain();\n          }\n        },\n\n        switchToLogin() {\n          this.viewLogin.classList.add('active');\n          this.viewMain.classList.remove('active');\n        },\n\n        switchToMain() {\n          this.viewLogin.classList.remove('active');\n          this.viewMain.classList.add('active');\n          this.contentDiv.style.display = 'block';\n\n          // 滚动到最底部模拟终端打印完毕\n          const contentBox = document.getElementById('hl-content');\n          if (contentBox) {\n            setTimeout(() => {\n              contentBox.scrollTop = contentBox.scrollHeight;\n            }, 100);\n          }\n        },\n\n        // 4. 颜色与阈值自适应绑定\n        bindAutoColors() {\n          const nodes = document.querySelectorAll('.hl-auto-color');\n          nodes.forEach(node => {\n            const type = node.getAttribute('data-type');\n            // 提取包含的数字，例如 \"85\" 来自 \"{{getvar::健康值|85}}\" 已解析的内容\n            const match = node.innerText.match(/\\d+/);\n            if (!match) return;\n\n            const val = parseInt(match[0], 10);\n\n            // 去除掉旧的阈值类\n            node.classList.remove('hl-val-danger', 'hl-val-warning', 'hl-val-success');\n\n            if (type === 'hp') {\n              if (val < 30) node.classList.add('hl-val-danger');\n              else if (val < 60) node.classList.add('hl-val-warning');\n              else node.classList.add('hl-val-success');\n            } else if (type === 'san') {\n              // SAN 值通常低于 40 就疯了\n              if (val < 40) node.classList.add('hl-val-danger');\n              else if (val < 70) node.classList.add('hl-val-warning');\n              else node.classList.add('hl-val-success');\n            }\n          });\n        },\n\n        // 5. 文本净化器 (隐藏 ST 的控制标签，防止破坏前端)\n        cleanUpInjectedText() {\n          if (!this.contentDiv) return;\n          // 如果内部有诸如 <UpdateVariable> 等系统命令，隐藏它们。通常世界书会输出它。\n          // 使用正则把特定的指令块包裹到隐藏 div 中\n          let innerHTML = this.contentDiv.innerHTML;\n          innerHTML = innerHTML.replace(\n            /<UpdateVariable[\\s\\S]*?>[\\s\\S]*?<\\/UpdateVariable>/gi,\n            '<div class=\"hl-hidden-sys\">$&</div>',\n          );\n          innerHTML = innerHTML.replace(/\\[route\\][\\s\\S]*?\\n/gi, '<div class=\"hl-hidden-sys\">$&</div>');\n          this.contentDiv.innerHTML = innerHTML;\n        },\n\n        // 6. 开局按钮触发\n        startGame() {\n          this.switchToMain();\n          this.dispatch('【终端连接请求】申请分配第一位患者。');\n        },\n\n        // 7. 发送指令分发器 (兼容 ST 两种发送模式)\n        dispatch(cmd) {\n          console.log('[HL_App] Dispatching command:', cmd);\n          this.setUiMessage('指令发射中...', 'var(--hl-primary)');\n\n          // 通道 1: SillyTavern 新版的内置扩展 API\n          if (typeof window !== 'undefined' && window.SlashCommandParser) {\n            try {\n              window.SlashCommandParser.executeSlash(`/send ${cmd}`);\n              this.setUiMessage('发射成功', 'var(--hl-success)');\n              return;\n            } catch (e) {\n              console.warn('[HL_App] SlashCommand failed, fallback to DOM injection.', e);\n            }\n          }\n\n          // 通道 2: DOM 强注回退模式 (Fallback for older ST versions)\n          const textarea = document.getElementById('send_textarea');\n          const sendBtn = document.getElementById('send_but');\n\n          if (textarea && sendBtn) {\n            // React 的受控组件破解法\n            const nativeInputValueSetter = Object.getOwnPropertyDescriptor(\n              window.HTMLTextAreaElement.prototype,\n              'value',\n            ).set;\n            nativeInputValueSetter.call(textarea, cmd);\n            textarea.dispatchEvent(new Event('input', { bubbles: true }));\n\n            setTimeout(() => {\n              sendBtn.click();\n              this.setUiMessage('发射成功', 'var(--hl-success)');\n            }, 50);\n          } else {\n            console.error('[HL_App] ST chat box not found!');\n            this.setUiMessage('连接失败', 'var(--hl-danger)');\n            navigator.clipboard.writeText(cmd).then(() => {\n              alert(`终端接口离线，指令已备份至您的剪贴板: ${cmd}`);\n            });\n          }\n        },\n\n        // 辅助：小状态更新器\n        setUiMessage(msg, color) {\n          if (!this.uiStatus) return;\n          this.uiStatus.innerText = msg;\n          this.uiStatus.style.color = color;\n          setTimeout(() => {\n            this.uiStatus.innerText = '终端链接稳定';\n            this.uiStatus.style.color = 'var(--hl-success)';\n          }, 3000);\n        },\n      };\n\n      // 引擎挂载 (支持重绘时自启动)\n      setTimeout(() => HL_App.init(), 50);\n    </script>\n  </body>\n</html>\n",
