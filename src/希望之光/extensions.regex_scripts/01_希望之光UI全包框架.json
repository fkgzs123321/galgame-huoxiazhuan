[
  {
    "id": "hope-light-ui",
    "scriptName": "希望之光全包UI框架",
    "findRegex": "^([\\s\\S]*)$",
    "replaceString": "<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>希望之光 - 临终关怀中心</title>\n    <style>\n      /* 希望之光 核心UI变量 */\n      :root {\n        /* 医疗/科幻 暗哑色系 */\n        --hl-bg-dark: #0f172a;\n        --hl-panel-bg: rgba(30, 41, 59, 0.75);\n        --hl-panel-border: rgba(56, 189, 248, 0.2);\n\n        /* 强调色 */\n        --hl-primary: #0ea5e9;\n        --hl-primary-glow: rgba(14, 165, 233, 0.4);\n        --hl-success: #10b981;\n        --hl-warning: #f59e0b;\n        --hl-danger: #ef4444;\n        --hl-text-main: #f8fafc;\n        --hl-text-muted: #94a3b8;\n\n        --hl-radius: 12px;\n        --hl-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n      }\n\n      /* 基础样式重置 */\n      .hl-wrapper {\n        position: relative;\n        width: 100%;\n        min-height: 400px; /* 在聊天框中的最小高度 */\n        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;\n        background: var(--hl-bg-dark);\n        color: var(--hl-text-main);\n        border-radius: var(--hl-radius);\n        border: 1px solid var(--hl-panel-border);\n        overflow: hidden;\n        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);\n        display: flex;\n        flex-direction: column;\n        box-sizing: border-box;\n        background-image:\n          radial-gradient(circle at 50% 0%, var(--hl-primary-glow) 0%, transparent 50%),\n          linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.4));\n      }\n\n      .hl-wrapper * {\n        box-sizing: border-box;\n      }\n\n      /* 玻璃面板通用类 */\n      .hl-glass {\n        background: var(--hl-panel-bg);\n        backdrop-filter: blur(10px);\n        -webkit-backdrop-filter: blur(10px);\n        border: 1px solid var(--hl-panel-border);\n      }\n\n      /* 按钮通用类 */\n      .hl-btn {\n        background: transparent;\n        color: var(--hl-primary);\n        border: 1px solid var(--hl-primary);\n        padding: 8px 16px;\n        border-radius: 6px;\n        cursor: pointer;\n        font-size: 14px;\n        font-weight: 500;\n        transition: var(--hl-transition);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 6px;\n      }\n\n      .hl-btn:hover {\n        background: var(--hl-primary);\n        color: #fff;\n        box-shadow: 0 0 12px var(--hl-primary-glow);\n        transform: translateY(-1px);\n      }\n\n      .hl-btn:active {\n        transform: translateY(1px);\n      }\n\n      .hl-btn.danger {\n        color: var(--hl-danger);\n        border-color: var(--hl-danger);\n      }\n      .hl-btn.danger:hover {\n        background: var(--hl-danger);\n        color: #fff;\n        box-shadow: 0 0 12px rgba(239, 68, 68, 0.4);\n      }\n\n      /* ===== 开局视图 ===== */\n      .hl-view-start {\n        display: none;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n        padding: 40px 20px;\n        text-align: center;\n        height: 100%;\n        min-height: 500px;\n      }\n\n      .hl-view-start.active {\n        display: flex;\n        animation: fadeIn 0.5s ease;\n      }\n\n      .hl-logo-container {\n        margin-bottom: 30px;\n        position: relative;\n      }\n\n      .hl-logo-icon {\n        font-size: 48px;\n        color: var(--hl-primary);\n        text-shadow: 0 0 20px var(--hl-primary-glow);\n        margin-bottom: 16px;\n        animation: pulse 2s infinite;\n      }\n\n      .hl-title {\n        font-size: 28px;\n        font-weight: bold;\n        letter-spacing: 2px;\n        margin: 0 0 10px 0;\n        color: #fff;\n      }\n\n      .hl-subtitle {\n        font-size: 14px;\n        color: var(--hl-text-muted);\n        margin: 0 0 30px 0;\n      }\n\n      .hl-start-info {\n        max-width: 400px;\n        text-align: left;\n        margin-bottom: 40px;\n        padding: 20px;\n        border-radius: 8px;\n        font-size: 13px;\n        line-height: 1.6;\n      }\n\n      .hl-start-info ul {\n        padding-left: 20px;\n        margin-top: 10px;\n        color: var(--hl-text-muted);\n      }\n\n      .hl-btn-large {\n        padding: 12px 40px;\n        font-size: 16px;\n        border-width: 2px;\n      }\n\n      /* ===== 正文视图 (游戏UI) ===== */\n      .hl-view-main {\n        display: none;\n        flex-direction: column;\n        height: 100%;\n      }\n\n      .hl-view-main.active {\n        display: flex;\n        animation: fadeIn 0.5s ease;\n      }\n\n      /* 顶部状态栏 */\n      .hl-header {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        padding: 12px 20px;\n        border-bottom: 1px solid var(--hl-panel-border);\n        background: rgba(15, 23, 42, 0.8);\n      }\n\n      .hl-header-left {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n        font-size: 15px;\n        font-weight: bold;\n      }\n\n      .hl-status-dot {\n        width: 8px;\n        height: 8px;\n        border-radius: 50%;\n        background: var(--hl-success);\n        box-shadow: 0 0 8px var(--hl-success);\n      }\n\n      /* 状态指示器区 */\n      .hl-stats-bar {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 16px;\n        padding: 12px 20px;\n        background: rgba(0, 0, 0, 0.2);\n        border-bottom: 1px solid var(--hl-panel-border);\n      }\n\n      .hl-stat-item {\n        display: flex;\n        align-items: center;\n        gap: 8px;\n        font-size: 13px;\n      }\n\n      .hl-stat-label {\n        color: var(--hl-text-muted);\n      }\n\n      .hl-stat-value {\n        font-family: monospace;\n        font-weight: bold;\n        font-size: 14px;\n      }\n\n      .hl-stat-value.danger {\n        color: var(--hl-danger);\n      }\n      .hl-stat-value.warning {\n        color: var(--hl-warning);\n      }\n      .hl-stat-value.success {\n        color: var(--hl-success);\n      }\n      .hl-stat-value.primary {\n        color: var(--hl-primary);\n      }\n\n      /* 内容区 (AI 回复的正文) */\n      .hl-content-area {\n        flex: 1;\n        padding: 20px;\n        font-size: 15px;\n        line-height: 1.7;\n        overflow-y: auto;\n        color: #e2e8f0;\n      }\n\n      .hl-content-area p {\n        margin-top: 0;\n        margin-bottom: 1em;\n      }\n\n      /* 底部行动控制面板 */\n      .hl-action-panel {\n        padding: 16px 20px;\n        border-top: 1px solid var(--hl-panel-border);\n        background: rgba(15, 23, 42, 0.9);\n        display: flex;\n        flex-direction: column;\n        gap: 12px;\n      }\n\n      .hl-action-grid {\n        display: grid;\n        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));\n        gap: 10px;\n      }\n\n      /* 动画 */\n      @keyframes fadeIn {\n        from {\n          opacity: 0;\n          transform: translateY(10px);\n        }\n        to {\n          opacity: 1;\n          transform: translateY(0);\n        }\n      }\n      @keyframes pulse {\n        0% {\n          transform: scale(1);\n          opacity: 1;\n        }\n        50% {\n          transform: scale(1.05);\n          opacity: 0.8;\n        }\n        100% {\n          transform: scale(1);\n          opacity: 1;\n        }\n      }\n\n      /* AI 隐藏指令区块 */\n      .hl-hidden-commands {\n        display: none !important;\n      }\n    </style>\n  </head>\n  <body>\n    <!-- 这个外层 div 是供 ST 正则替换时直接包裹原始文本的容器 -->\n    <div class=\"hl-wrapper\" id=\"hl-app-root\">\n      <!-- 视图 1：开局画面 -->\n      <!-- 逻辑：如果变量表示还未开局，或者这是首条消息，则显示此界面 -->\n      <div class=\"hl-view-start\" id=\"hl-view-start\">\n        <div class=\"hl-logo-container\">\n          <div class=\"hl-logo-icon\">⚕️</div>\n          <h1 class=\"hl-title\">希望之光</h1>\n          <p class=\"hl-subtitle\">HOPE LIGHT HOSPICE CENTER</p>\n        </div>\n\n        <div class=\"hl-start-info hl-glass\">\n          <p style=\"margin-top: 0; color: var(--hl-primary); font-weight: bold\">系统初始化完成</p>\n          <p>欢迎入职「希望之光」临终关怀中心。您的终端已接入主网。</p>\n          <ul>\n            <li>请时刻注意您的<strong>精神状态</strong>（San值）。</li>\n            <li>所有护理行为均需受<strong>合规状态</strong>监管。</li>\n            <li>努力积攒<strong>经费</strong>应对突发状况。</li>\n          </ul>\n        </div>\n\n        <button class=\"hl-btn hl-btn-large\" onclick=\"hl_startGame()\">\n          <span>确认入职 · 启动终端</span>\n        </button>\n      </div>\n\n      <!-- 视图 2：正文游玩界面 -->\n      <!-- 逻辑：这包含了顶部的各种属性面板，中间插入原始文本内容 -->\n      <div class=\"hl-view-main\" id=\"hl-view-main\">\n        <!-- 头部栏 -->\n        <div class=\"hl-header\">\n          <div class=\"hl-header-left\">\n            <div class=\"hl-status-dot\"></div>\n            <span>员工终端 v2.1.0</span>\n          </div>\n          <div style=\"font-size: 12px; color: var(--hl-text-muted)\">\n            <!-- 读取系统时间变量 -->\n            <span id=\"hl-val-time\">████-██-██</span>\n          </div>\n        </div>\n\n        <!-- 状态栏 -->\n        <div class=\"hl-stats-bar\">\n          <div class=\"hl-stat-item\" title=\"当前体力/健康\">\n            <span class=\"hl-stat-label\">❤️ HP</span>\n            <span class=\"hl-stat-value success\" id=\"hl-val-hp\">{{getvar::健康值|100}}</span>\n          </div>\n          <div class=\"hl-stat-item\" title=\"精神状态 (理智值)\">\n            <span class=\"hl-stat-label\">🧠 SAN</span>\n            <span class=\"hl-stat-value warning\" id=\"hl-val-san\">{{getvar::理智值|100}}</span>\n          </div>\n          <div class=\"hl-stat-item\" title=\"当前可用经费\">\n            <span class=\"hl-stat-label\">🪙 经费</span>\n            <span class=\"hl-stat-value primary\" id=\"hl-val-money\">{{getvar::经费|0}}</span>\n          </div>\n          <div class=\"hl-stat-item\" title=\"合法性/违规警告\">\n            <span class=\"hl-stat-label\">⚖️ 合规</span>\n            <span class=\"hl-stat-value\" id=\"hl-val-compliance\">{{getvar::合规状态|正常}}</span>\n          </div>\n        </div>\n\n        <!-- 核心文本区 (AI生成的内容会放在这里) -->\n        <div class=\"hl-content-area custom-scrollbar\" id=\"hl-story-content\">\n          <!-- 特殊标记：这里在正则中会被替换为真实捕捉到的正文内容 -->\n          <div id=\"hl-injected-text\">\n            $1\n          </div>\n        </div>\n\n        <!-- 底部快捷动作区 -->\n        <div class=\"hl-action-panel\">\n          <div style=\"font-size: 12px; color: var(--hl-text-muted); margin-bottom: 4px\">快捷指令覆盖授权：正常</div>\n          <div class=\"hl-action-grid\">\n            <button class=\"hl-btn\" onclick=\"hl_sendCommand('【基础护理】')\">💊 基础护理</button>\n            <button class=\"hl-btn\" onclick=\"hl_sendCommand('【心理交流】')\">💬 心理交流</button>\n            <button class=\"hl-btn\" onclick=\"hl_sendCommand('【医疗处置】')\">💉 医疗处置</button>\n            <button class=\"hl-btn\" onclick=\"hl_sendCommand('【查看档案】')\">📋 查看档案</button>\n            <button class=\"hl-btn danger\" onclick=\"hl_sendCommand('【紧急呼叫】')\">🚨 紧急状况</button>\n            <button class=\"hl-btn\" onclick=\"hl_sendCommand('【系统设置】')\">⚙️ 系统设置</button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <script>\n      /**\n       * 希望之光 UI 框架前端逻辑\n       */\n\n      // 初始化判定逻辑\n      function hl_init() {\n        // 判断当前内容是否属于开局\n        const contentDiv = document.getElementById('hl-injected-text');\n        const contentText = contentDiv ? contentDiv.innerText || '' : '';\n\n        const viewStart = document.getElementById('hl-view-start');\n        const viewMain = document.getElementById('hl-view-main');\n\n        // 解析内容中的 <upstore> 或是开局特有的标识\n        // 这里做一个简单的判定：如果包含了 [开局] 或者变量还不存在（通过判断hp占位符是否被解析），决定显示哪一面\n        // 作为示例，如果占位符没有被ST替换（包含'{{'），或者包含了特定的初始化文本，就显示开局\n        const isFirstMessage =\n          contentText.includes('【终端未激活】') || contentText.includes('希望之光 - 临终关怀中心');\n\n        // 为了方便测试模式，可以通过 ST 变量控制\n        // 实际上这在一个会话中是针对当前气泡渲染的。如果是首条消息气泡，让它作为开局屏\n        if (isFirstMessage) {\n          viewStart.classList.add('active');\n          viewMain.classList.remove('active');\n          // 可以选择隐藏原文，因为开局屏幕已经足够\n          if (contentDiv) contentDiv.style.display = 'none';\n        } else {\n          viewStart.classList.remove('active');\n          viewMain.classList.add('active');\n          // 确保原文显示\n          if (contentDiv) contentDiv.style.display = 'block';\n        }\n\n        // 颜色阈值渲染更新\n        hl_updateColors();\n      }\n\n      // 启动游戏函数（开局屏点击）\n      function hl_startGame() {\n        const viewStart = document.getElementById('hl-view-start');\n        const viewMain = document.getElementById('hl-view-main');\n        viewStart.classList.remove('active');\n        viewMain.classList.add('active');\n\n        // 通过 ST 发送命令\n        hl_sendCommand('【终端激活】已确认入职，开始当日护工排班。');\n      }\n\n      // 更新数值颜色\n      function hl_updateColors() {\n        const hpEl = document.getElementById('hl-val-hp');\n        const sanEl = document.getElementById('hl-val-san');\n\n        if (hpEl) {\n          const hpMatch = hpEl.innerText.match(/\\d+/);\n          if (hpMatch) {\n            const hp = parseInt(hpMatch[0], 10);\n            if (hp < 30) hpEl.className = 'hl-stat-value danger';\n            else if (hp < 60) hpEl.className = 'hl-stat-value warning';\n            else hpEl.className = 'hl-stat-value success';\n          }\n        }\n\n        if (sanEl) {\n          const sanMatch = sanEl.innerText.match(/\\d+/);\n          if (sanMatch) {\n            const san = parseInt(sanMatch[0], 10);\n            if (san < 40) sanEl.className = 'hl-stat-value danger';\n            else if (san < 70) sanEl.className = 'hl-stat-value warning';\n            else sanEl.className = 'hl-stat-value success';\n          }\n        }\n      }\n\n      // 核心发送命令桥接函数\n      function hl_sendCommand(cmd) {\n        console.log('[HopeLight] Sending command:', cmd);\n\n        // 尝试使用 SillyTavern 的内置 SlashCommand API\n        if (typeof window !== 'undefined' && window.SlashCommandParser) {\n          try {\n            window.SlashCommandParser.executeSlash(`/send ${cmd}`);\n            return;\n          } catch (e) {\n            console.warn('[HopeLight] SlashCommand API failed, falling back to DOM.', e);\n          }\n        }\n\n        // 保底方案：操作 DOM 向 textarea 输入并点击发送\n        const textarea = document.getElementById('send_textarea');\n        const sendBtn = document.getElementById('send_but');\n\n        if (textarea && sendBtn) {\n          const nativeInputValueSetter = Object.getOwnPropertyDescriptor(\n            window.HTMLTextAreaElement.prototype,\n            'value',\n          ).set;\n          // 获取当前文本框已有内容，如果是追加的话，这里我们直接替换\n          nativeInputValueSetter.call(textarea, cmd);\n\n          // 触发 React/DOM 的 input 事件，使其捕获数据更新\n          textarea.dispatchEvent(new Event('input', { bubbles: true }));\n\n          // 模拟点击发送按钮\n          setTimeout(() => {\n            sendBtn.click();\n          }, 100);\n        } else {\n          console.error('[HopeLight] Cannot find ST chat controls. Ensure you are in SillyTavern.');\n          // 复制到剪贴板作为备用\n          navigator.clipboard.writeText(cmd).then(() => {\n            alert(`未能连接到系统发送接口，指令已复制到剪贴板: ${cmd}`);\n          });\n        }\n      }\n\n      // 页面加载或插入DOM后立刻执行初始化\n      setTimeout(hl_init, 100);\n    </script>\n  </body>\n</html>\n",
    "trimStrings": [],
    "placement": [
      1,
      2
    ],
    "disabled": false,
    "markdownOnly": false,
    "promptOnly": false,
    "runOnEdit": true,
    "runOnRead": true,
    "runOnActivity": false,
    "color": "rgba(4, 169, 198, 1)",
    "minDepth": null,
    "maxDepth": null
  }
]