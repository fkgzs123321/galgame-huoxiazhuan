[
  {
    "id": "hope-light-ui-v4",
    "scriptName": "希望之光真实设置全包UI框架",
    "findRegex": "^([\\s\\S]*)$",
    "replaceString": "<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\" />\n    <title>希望之光 - 临终关怀中心</title>\n    <style>\n      /* ========================================\n           CSS 变量主题系统：赛博医疗 / 寂静深海\n           ======================================== */\n      :root {\n        --hl-bg-base: #020617;\n        --hl-bg-panel: rgba(15, 23, 42, 0.75);\n        --hl-bg-panel-solid: rgba(15, 23, 42, 0.95);\n        --hl-bg-overlay: rgba(2, 6, 23, 0.85);\n\n        --hl-primary: #0ea5e9;\n        --hl-primary-glow: rgba(14, 165, 233, 0.4);\n\n        --hl-success: #10b981;\n        --hl-warning: #f59e0b;\n        --hl-danger: #ef4444;\n        --hl-danger-glow: rgba(239, 68, 68, 0.6);\n        --hl-purple: #8b5cf6;\n\n        --hl-text-main: #f8fafc;\n        --hl-text-muted: #64748b;\n\n        --hl-border: rgba(14, 165, 233, 0.2);\n        --hl-border-bright: rgba(14, 165, 233, 0.5);\n        --hl-shadow: 0 4px 12px rgba(0, 0, 0, 0.5);\n        --hl-shadow-glow: 0 0 15px var(--hl-primary-glow);\n\n        --hl-radius: 8px;\n        --hl-transition-fast: 0.15s ease-out;\n      }\n\n      .hl-root-wrapper {\n        position: relative;\n        width: 100%;\n        height: 100%;\n        min-height: 550px;\n        max-height: 85vh;\n        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;\n        background-color: var(--hl-bg-base);\n        color: var(--hl-text-main);\n        border-radius: var(--hl-radius);\n        border: 1px solid var(--hl-border);\n        overflow: hidden;\n        display: flex;\n        flex-direction: column;\n        box-shadow: var(--hl-shadow);\n        background-image: radial-gradient(circle at 50% 0%, rgba(14, 165, 233, 0.1) 0%, transparent 70%);\n      }\n\n      .hl-root-wrapper::after {\n        content: ' ';\n        display: block;\n        pointer-events: none;\n        position: absolute;\n        top: 0;\n        left: 0;\n        bottom: 0;\n        right: 0;\n        background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%);\n        background-size: 100% 4px;\n        z-index: 999;\n        opacity: 0.6;\n      }\n\n      .hl-root-wrapper * {\n        box-sizing: border-box;\n        scrollbar-width: thin;\n        scrollbar-color: var(--hl-border) transparent;\n      }\n      .hl-scroll::-webkit-scrollbar {\n        width: 4px;\n      }\n      .hl-scroll::-webkit-scrollbar-track {\n        background: transparent;\n      }\n      .hl-scroll::-webkit-scrollbar-thumb {\n        background: var(--hl-border);\n        border-radius: 2px;\n      }\n\n      @keyframes hl-fade-in {\n        from {\n          opacity: 0;\n          transform: translateY(10px);\n        }\n        to {\n          opacity: 1;\n          transform: translateY(0);\n        }\n      }\n\n      .hl-label {\n        display: block;\n        font-size: 11px;\n        color: var(--hl-text-muted);\n        margin-bottom: 6px;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n      }\n\n      .hl-input,\n      .hl-select {\n        width: 100%;\n        background: rgba(0, 0, 0, 0.5);\n        border: 1px solid var(--hl-border-bright);\n        color: var(--hl-text-main);\n        padding: 8px 12px;\n        font-family: inherit;\n        font-size: 13px;\n        border-radius: 4px;\n        outline: none;\n        transition: var(--hl-transition-fast);\n      }\n      .hl-input:focus,\n      .hl-select:focus {\n        border-color: var(--hl-primary);\n        box-shadow: 0 0 8px var(--hl-primary-glow);\n        background: rgba(14, 165, 233, 0.05);\n      }\n      .hl-select option {\n        background: var(--hl-bg-base);\n        color: var(--hl-text-main);\n      }\n\n      .hl-toggle-row {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        padding: 8px 0;\n        border-bottom: 1px dashed var(--hl-border);\n      }\n      .hl-toggle-row:last-child {\n        border-bottom: none;\n      }\n      .hl-toggle-text {\n        display: flex;\n        flex-direction: column;\n        gap: 2px;\n      }\n      .hl-toggle-title {\n        font-size: 13px;\n        color: var(--hl-text-main);\n      }\n      .hl-toggle-desc {\n        font-size: 10px;\n        color: var(--hl-text-muted);\n      }\n\n      .hl-switch {\n        position: relative;\n        display: inline-block;\n        width: 36px;\n        height: 20px;\n      }\n      .hl-switch input {\n        opacity: 0;\n        width: 0;\n        height: 0;\n      }\n      .hl-slider {\n        position: absolute;\n        cursor: pointer;\n        top: 0;\n        left: 0;\n        right: 0;\n        bottom: 0;\n        background-color: rgba(255, 255, 255, 0.1);\n        transition: 0.3s;\n        border-radius: 20px;\n        border: 1px solid var(--hl-text-muted);\n      }\n      .hl-slider:before {\n        position: absolute;\n        content: '';\n        height: 14px;\n        width: 14px;\n        left: 2px;\n        bottom: 2px;\n        background-color: var(--hl-text-muted);\n        transition: 0.3s;\n        border-radius: 50%;\n      }\n      input:checked + .hl-slider {\n        background-color: var(--hl-primary);\n        border-color: var(--hl-primary);\n        box-shadow: 0 0 10px var(--hl-primary-glow);\n      }\n      input:checked + .hl-slider:before {\n        transform: translateX(16px);\n        background-color: #fff;\n      }\n      input.danger-toggle:checked + .hl-slider {\n        background-color: var(--hl-danger);\n        border-color: var(--hl-danger);\n        box-shadow: 0 0 10px var(--hl-danger-glow);\n      }\n\n      .hl-btn {\n        background: rgba(14, 165, 233, 0.1);\n        color: var(--hl-text-main);\n        border: 1px solid var(--hl-border-bright);\n        padding: 10px 20px;\n        border-radius: 6px;\n        cursor: pointer;\n        font-family: inherit;\n        font-size: 14px;\n        font-weight: bold;\n        transition: var(--hl-transition-fast);\n        text-transform: uppercase;\n        width: 100%;\n      }\n      .hl-btn:hover {\n        border-color: var(--hl-primary);\n        box-shadow: var(--hl-shadow-glow);\n        color: var(--hl-primary);\n        background: rgba(14, 165, 233, 0.2);\n      }\n      .hl-btn:active {\n        transform: scale(0.98);\n      }\n\n      /* VIEWS */\n      .hl-view-login {\n        display: none;\n        flex-direction: column;\n        width: 100%;\n        height: 100%;\n        position: relative;\n        z-index: 10;\n      }\n      .hl-view-login.active {\n        display: flex;\n        animation: hl-fade-in 0.6s ease-out forwards;\n      }\n\n      .hl-creation-header {\n        padding: 16px 20px;\n        background: var(--hl-bg-overlay);\n        border-bottom: 1px solid var(--hl-border);\n        text-align: center;\n      }\n      .hl-creation-title {\n        font-size: 18px;\n        color: var(--hl-primary);\n        margin: 0 0 4px 0;\n        letter-spacing: 2px;\n        text-shadow: 0 0 10px var(--hl-primary-glow);\n      }\n      .hl-creation-subtitle {\n        font-size: 11px;\n        color: var(--hl-text-muted);\n        margin: 0;\n      }\n\n      .hl-creation-body {\n        flex: 1;\n        padding: 16px;\n        overflow-y: auto;\n        display: flex;\n        flex-direction: column;\n        gap: 16px;\n      }\n\n      .hl-form-section {\n        background: rgba(0, 0, 0, 0.3);\n        border: 1px solid var(--hl-border);\n        border-radius: 6px;\n        padding: 16px;\n        position: relative;\n      }\n      .hl-form-section::before {\n        content: attr(data-title);\n        position: absolute;\n        top: -9px;\n        left: 12px;\n        background: var(--hl-bg-base);\n        padding: 0 6px;\n        font-size: 10px;\n        color: var(--hl-primary);\n        font-weight: bold;\n      }\n\n      .hl-form-grid {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 12px;\n      }\n      .hl-form-full {\n        grid-column: 1 / -1;\n        margin-top: 4px;\n      }\n\n      .hl-creation-footer {\n        padding: 16px 20px;\n        background: var(--hl-bg-panel-solid);\n        border-top: 1px solid var(--hl-border);\n      }\n\n      .hl-view-main {\n        display: none;\n        flex-direction: column;\n        height: 100%;\n        position: relative;\n        z-index: 10;\n      }\n      .hl-view-main.active {\n        display: flex;\n        animation: hl-fade-in 0.5s ease-out forwards;\n      }\n\n      .hl-navbar {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        padding: 10px 16px;\n        background: var(--hl-bg-panel-solid);\n        border-bottom: 1px solid var(--hl-border);\n      }\n      .hl-nav-left {\n        display: flex;\n        align-items: center;\n        gap: 8px;\n        font-size: 12px;\n        color: var(--hl-primary);\n      }\n      .hl-dash-dot {\n        width: 6px;\n        height: 6px;\n        border-radius: 50%;\n        background: var(--hl-success);\n        box-shadow: 0 0 8px var(--hl-success);\n      }\n      .hl-nav-right {\n        font-size: 11px;\n        color: var(--hl-text-muted);\n      }\n\n      .hl-dashboard {\n        display: grid;\n        grid-template-columns: repeat(4, 1fr);\n        gap: 1px;\n        background: var(--hl-border);\n        border-bottom: 1px solid var(--hl-border);\n      }\n      .hl-dash-item {\n        background: var(--hl-bg-panel);\n        padding: 10px 4px;\n        text-align: center;\n        display: flex;\n        flex-direction: column;\n        gap: 4px;\n      }\n      .hl-dash-label {\n        font-size: 9px;\n        color: var(--hl-text-muted);\n        text-transform: uppercase;\n      }\n      .hl-dash-val {\n        font-size: 15px;\n        font-weight: bold;\n        color: var(--hl-text-main);\n      }\n\n      .hl-val-danger {\n        color: var(--hl-danger);\n        text-shadow: 0 0 8px var(--hl-danger-glow);\n      }\n      .hl-val-warning {\n        color: var(--hl-warning);\n      }\n      .hl-val-success {\n        color: var(--hl-success);\n      }\n      .hl-val-info {\n        color: var(--hl-primary);\n        text-shadow: 0 0 8px var(--hl-primary-glow);\n      }\n\n      .hl-content-box {\n        flex: 1;\n        padding: 16px 20px;\n        overflow-y: auto;\n        position: relative;\n        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', sans-serif;\n        font-size: 14px;\n        line-height: 1.7;\n        color: #d1d5db;\n      }\n      .hl-hidden-sys {\n        display: none !important;\n      }\n\n      .hl-action-pad {\n        background: var(--hl-bg-panel-solid);\n        border-top: 1px solid var(--hl-border);\n        padding: 12px 16px;\n      }\n      .hl-action-grid {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: 8px;\n      }\n      .hl-btn-sm {\n        padding: 8px 12px;\n        font-size: 12px;\n      }\n      @media (max-width: 480px) {\n        .hl-action-grid {\n          grid-template-columns: repeat(2, 1fr);\n        }\n      }\n    </style>\n  </head>\n  <body>\n    <div class=\"hl-root-wrapper\" id=\"hl-app\">\n      <!-- ==============================================\n         视图一：系统开局 - 系统参数录入台 (Real Configuration)\n         ============================================== -->\n      <div class=\"hl-view-login hl-scroll\" id=\"hl-view-login\">\n        <div class=\"hl-creation-header\">\n          <h1 class=\"hl-creation-title\">希望之光 • 规则控制终端</h1>\n          <p class=\"hl-creation-subtitle\">SYSTEM PARAMETER OVERRIDE</p>\n        </div>\n\n        <div class=\"hl-creation-body\">\n          <!-- 1. 玩家与难度 (核心) -->\n          <div class=\"hl-form-section\" data-title=\"[01] 核心档案与难度\">\n            <div class=\"hl-form-grid\">\n              <div>\n                <label class=\"hl-label\">护工姓名</label>\n                <input type=\"text\" id=\"hl-form-name\" class=\"hl-input\" placeholder=\"输入姓名 (可选)\" />\n              </div>\n              <div>\n                <label class=\"hl-label\">游玩难度评定</label>\n                <select id=\"hl-form-diff\" class=\"hl-select\">\n                  <option value=\"新手\">新手 (DC检定-2)</option>\n                  <option value=\"标准\" selected>标准 (DC检定+0)</option>\n                  <option value=\"困难\">困难 (DC检定+2)</option>\n                  <option value=\"专家\">专家 (DC检定+4)</option>\n                </select>\n              </div>\n            </div>\n          </div>\n\n          <!-- 2. 系统模式控制 -->\n          <div class=\"hl-form-section\" data-title=\"[02] 叙事与架构控制\">\n            <div class=\"hl-form-grid\">\n              <div>\n                <label class=\"hl-label\">MVU输出模式</label>\n                <select id=\"hl-form-mvu\" class=\"hl-select\">\n                  <option value=\"严格\">严格 (仅白名单)</option>\n                  <option value=\"兼容\" selected>兼容 (允许扩展描述)</option>\n                  <option value=\"调试\">调试 (输出中间值)</option>\n                </select>\n              </div>\n              <div>\n                <label class=\"hl-label\">地图展示模式</label>\n                <select id=\"hl-form-map\" class=\"hl-select\">\n                  <option value=\"简版\">简版展示</option>\n                  <option value=\"详细\" selected>详细展示</option>\n                  <option value=\"剧情\">隐入剧情展示</option>\n                </select>\n              </div>\n            </div>\n          </div>\n\n          <!-- 3. 内容防火墙状态 -->\n          <div class=\"hl-form-section\" data-title=\"[03] DLC与合规安全阀\">\n            <div class=\"hl-toggle-row\">\n              <div class=\"hl-toggle-text\">\n                <span class=\"hl-toggle-title\">DLC 系统总控</span>\n                <span class=\"hl-toggle-desc\">开放外部 DLC 剧情支线进入权限。</span>\n              </div>\n              <label class=\"hl-switch\">\n                <input type=\"checkbox\" id=\"hl-form-dlc\" checked />\n                <span class=\"hl-slider\"></span>\n              </label>\n            </div>\n\n            <div class=\"hl-toggle-row\">\n              <div class=\"hl-toggle-text\">\n                <span class=\"hl-toggle-title\">NSFW 全局解禁</span>\n                <span class=\"hl-toggle-desc\">允许特殊成人/猎奇向互动基础判定。</span>\n              </div>\n              <label class=\"hl-switch\">\n                <input type=\"checkbox\" id=\"hl-form-nsfw-main\" class=\"danger-toggle\" />\n                <span class=\"hl-slider\"></span>\n              </label>\n            </div>\n\n            <div class=\"hl-toggle-row\">\n              <div class=\"hl-toggle-text\">\n                <span class=\"hl-toggle-title\">NSFW 深度扩展模块</span>\n                <span class=\"hl-toggle-desc\">额外解锁深层特殊玩法与极端变异。</span>\n              </div>\n              <label class=\"hl-switch\">\n                <input type=\"checkbox\" id=\"hl-form-nsfw-ext\" class=\"danger-toggle\" />\n                <span class=\"hl-slider\"></span>\n              </label>\n            </div>\n\n            <div class=\"hl-toggle-row\">\n              <div class=\"hl-toggle-text\">\n                <span class=\"hl-toggle-title\">NSFW 特定语料库连结</span>\n                <span class=\"hl-toggle-desc\">唤醒世界书特定语汇库，增强相关描绘感染力。</span>\n              </div>\n              <label class=\"hl-switch\">\n                <input type=\"checkbox\" id=\"hl-form-nsfw-corpus\" />\n                <span class=\"hl-slider\"></span>\n              </label>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"hl-creation-footer\">\n          <button class=\"hl-btn\" onclick=\"HL_App.submitCreation()\">[ 确立系统参数并入网 / BOOT ]</button>\n        </div>\n      </div>\n\n      <!-- ==============================================\n         视图二：主控台 (正文与日常操作)\n         ============================================== -->\n      <div class=\"hl-view-main\" id=\"hl-view-main\">\n        <div class=\"hl-navbar\">\n          <div class=\"hl-nav-left\">\n            <div class=\"hl-dash-dot\"></div>\n            <span>HL-OS / NODE_ACT_ACTIVE</span>\n          </div>\n          <div class=\"hl-nav-right\">\n            <span id=\"hl-time\">{{getvar::当前时间|未知}}</span>\n          </div>\n        </div>\n\n        <div class=\"hl-dashboard\">\n          <div class=\"hl-dash-item\">\n            <span class=\"hl-dash-label\">HP 健康</span>\n            <span class=\"hl-dash-val hl-auto-color\" data-type=\"hp\">{{getvar::健康值|100}}</span>\n          </div>\n          <div class=\"hl-dash-item\">\n            <span class=\"hl-dash-label\">SAN 理智</span>\n            <span class=\"hl-dash-val hl-auto-color\" data-type=\"san\">{{getvar::理智值|100}}</span>\n          </div>\n          <div class=\"hl-dash-item\">\n            <span class=\"hl-dash-label\">经费余额</span>\n            <span class=\"hl-dash-val hl-val-info\">${{getvar::经费|0}}</span>\n          </div>\n          <div class=\"hl-dash-item\">\n            <span class=\"hl-dash-label\">合规审计</span>\n            <span class=\"hl-dash-val\">{{getvar::合规状态|正常}}</span>\n          </div>\n        </div>\n\n        <div class=\"hl-content-box hl-scroll\" id=\"hl-content\">\n          <div id=\"hl-injected-text\">\n            $1\n          </div>\n        </div>\n\n        <div class=\"hl-action-pad\">\n          <div class=\"hl-action-grid\">\n            <button class=\"hl-btn hl-btn-sm\" onclick=\"HL_App.dispatch('【系统设置】')\">⚙️ 系统设置</button>\n            <button class=\"hl-btn hl-btn-sm\" onclick=\"HL_App.dispatch('【属性总览】')\">📊 属性面板</button>\n            <button class=\"hl-btn hl-btn-sm\" onclick=\"HL_App.dispatch('【DLC总览】')\">🧩 扩展列表</button>\n            <button class=\"hl-btn hl-btn-sm\" onclick=\"HL_App.dispatch('【NSFW状态】')\">🔞 协议检查</button>\n            <button class=\"hl-btn hl-btn-sm\" onclick=\"HL_App.dispatch('【基础护理】')\">💊 基础护理</button>\n            <button class=\"hl-btn hl-btn-sm danger\" onclick=\"HL_App.dispatch('【查看判定细节】')\">⚖️ 最后判定</button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <script>\n      /**\n       * 希望之光终端应用引擎 (Hope Light OS Engine V4)\n       * 系统原生指令对接版\n       */\n      const HL_App = {\n        init() {\n          this.cacheDOM();\n\n          const userMacro = '{{user}}';\n          if (userMacro && userMacro !== '{' + '{user}}') {\n            const nameInput = document.getElementById('hl-form-name');\n            if (nameInput && !nameInput.value) nameInput.value = userMacro;\n          }\n\n          this.routeView();\n          this.bindAutoColors();\n          this.cleanUpInjectedText();\n        },\n\n        cacheDOM() {\n          this.viewLogin = document.getElementById('hl-view-login');\n          this.viewMain = document.getElementById('hl-view-main');\n          this.contentDiv = document.getElementById('hl-injected-text');\n        },\n\n        routeView() {\n          if (!this.contentDiv) return;\n          const text = this.contentDiv.innerText || '';\n\n          // 真实开局检测：原角色卡的 first_mes 实际上输出的是 \"【开局】\" 等字眼\n          const isUninitialized =\n            text.includes('【开局】') || text.includes('开始入职登记') || text.includes('终端未激活');\n\n          // 限制长度是为了防止由于后期的剧情复述误触发（通常开局系统文都比较短）\n          if (isUninitialized && text.length < 800) {\n            this.switchToLogin();\n            this.contentDiv.style.display = 'none';\n          } else {\n            this.switchToMain();\n          }\n        },\n\n        switchToLogin() {\n          this.viewLogin.classList.add('active');\n          this.viewMain.classList.remove('active');\n        },\n        switchToMain() {\n          this.viewLogin.classList.remove('active');\n          this.viewMain.classList.add('active');\n          this.contentDiv.style.display = 'block';\n          const contentBox = document.getElementById('hl-content');\n          if (contentBox) setTimeout(() => (contentBox.scrollTop = contentBox.scrollHeight), 100);\n        },\n\n        // 建表提交：组装系统真实的连发配置指令\n        submitCreation() {\n          const name = document.getElementById('hl-form-name').value || '员工';\n          const diff = document.getElementById('hl-form-diff').value; // 新手|标准|困难|专家\n          const mvu = document.getElementById('hl-form-mvu').value; // 严格|兼容|调试\n          const mapMode = document.getElementById('hl-form-map').value; // 简版|详细|剧情\n\n          const dlc = document.getElementById('hl-form-dlc').checked ? '开' : '关';\n          const nsfw = document.getElementById('hl-form-nsfw-main').checked ? '开' : '关';\n          const nsfwExt = document.getElementById('hl-form-nsfw-ext').checked ? '开' : '关';\n          const nsfwCorp = document.getElementById('hl-form-nsfw-corpus').checked ? '开' : '关';\n\n          // 我们将所有真指令拼接在一起，作为一个强制环境初始化的宏发给模型\n          // 系统指令中采用括号形式确切调用世界书内绑定的开关\n          const multiCommands =\n            `【终端档案确立】员工：${name}。\\n` +\n            `【系统级指令连发以完成设定初始化】：\\n` +\n            `【难度 ${diff}】\\n` +\n            `【MVU模式 ${mvu}】\\n` +\n            `【地图模式 ${mapMode}】\\n` +\n            `【DLC ${dlc}】\\n` +\n            `【NSFW ${nsfw}】\\n` +\n            `【NSFW扩展开关 ${nsfwExt}】\\n` +\n            `【NSFW语料库 ${nsfwCorp}】\\n\\n` +\n            `请系统主理人根据上述设定，确认上述7个维度的模式状态，并为这位护工分配在《希望之光》机构的第一项基础任务。`;\n\n          this.switchToMain();\n          this.dispatch(multiCommands);\n        },\n\n        bindAutoColors() {\n          const nodes = document.querySelectorAll('.hl-auto-color');\n          nodes.forEach(node => {\n            const type = node.getAttribute('data-type');\n            const match = node.innerText.match(/\\d+/);\n            if (!match) return;\n\n            const val = parseInt(match[0], 10);\n            node.classList.remove('hl-val-danger', 'hl-val-warning', 'hl-val-success');\n\n            if (type === 'hp') {\n              if (val < 35) node.classList.add('hl-val-danger');\n              else if (val < 70) node.classList.add('hl-val-warning');\n              else node.classList.add('hl-val-success');\n            } else if (type === 'san') {\n              if (val < 40) node.classList.add('hl-val-danger');\n              else if (val < 75) node.classList.add('hl-val-warning');\n              else node.classList.add('hl-val-success');\n            }\n          });\n        },\n\n        cleanUpInjectedText() {\n          if (!this.contentDiv) return;\n          let innerHTML = this.contentDiv.innerHTML;\n          innerHTML = innerHTML.replace(\n            /<UpdateVariable[\\s\\S]*?>[\\s\\S]*?<\\/UpdateVariable>/gi,\n            '<div class=\"hl-hidden-sys\">$&</div>',\n          );\n          innerHTML = innerHTML.replace(/\\[route\\][\\s\\S]*?\\n/gi, '<div class=\"hl-hidden-sys\">$&</div>');\n          this.contentDiv.innerHTML = innerHTML;\n        },\n\n        dispatch(cmd) {\n          console.log('[HL] Dispatching =>', cmd);\n          if (typeof window !== 'undefined' && window.SlashCommandParser) {\n            try {\n              window.SlashCommandParser.executeSlash(`/send ${cmd}`);\n              return;\n            } catch (e) {\n              console.warn('[HL] SC failed, fallback DOM.', e);\n            }\n          }\n\n          const textarea = document.getElementById('send_textarea');\n          const sendBtn = document.getElementById('send_but');\n          if (textarea && sendBtn) {\n            const nativeInputValueSetter = Object.getOwnPropertyDescriptor(\n              window.HTMLTextAreaElement.prototype,\n              'value',\n            ).set;\n            nativeInputValueSetter.call(textarea, cmd);\n            textarea.dispatchEvent(new Event('input', { bubbles: true }));\n            setTimeout(() => sendBtn.click(), 50);\n          } else {\n            navigator.clipboard.writeText(cmd).then(() => {\n              alert(`终端发信组件离线，系统配置指令已被复制，请直接粘贴发送: \\n\\n${cmd}`);\n            });\n          }\n        },\n      };\n\n      setTimeout(() => HL_App.init(), 50);\n    </script>\n  </body>\n</html>\n",
    "trimStrings": [],
    "placement": [
      1,
      2
    ],
    "disabled": false,
