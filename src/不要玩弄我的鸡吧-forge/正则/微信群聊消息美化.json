{
  "id": "fjb-wechat-group-beautify",
  "scriptName": "微信群聊消息美化",
  "findRegex": "/<wechat_group\\s+group=\"([^\"]+)\"\\s*>([\\s\\S]*?)<\\/wechat_group>/g",
  "replaceString": "<style>\n.fjb-wc-container{max-width:95%;margin:10px auto;background:#EDEDED;border-radius:12px;overflow:hidden;font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;font-size:14px;color:#191919;border:1px solid #DCDCDC;}\n.fjb-wc-header{background:#EDEDED;color:#191919;padding:10px 14px;font-weight:600;font-size:15px;text-align:center;border-bottom:1px solid #D9D9D9;}\n.fjb-wc-header::before{content:'💬';margin-right:6px;}\n.fjb-wc-body{padding:10px 12px;max-height:450px;overflow-y:auto;background:#EDEDED;white-space:pre-wrap;}\n.fjb-wc-body::-webkit-scrollbar{width:4px;}\n.fjb-wc-body::-webkit-scrollbar-thumb{background:#C8C8CC;border-radius:2px;}\n.fjb-wc-body::-webkit-scrollbar-track{background:transparent;}\n.fjb-wc-line{display:flex;margin:8px 0;align-items:flex-start;}\n.fjb-wc-line.sys{justify-content:center;margin:6px 0;}\n.fjb-wc-sys-text{background:rgba(0,0,0,0.12);color:#999;font-size:12px;padding:3px 10px;border-radius:4px;max-width:85%;text-align:center;line-height:1.4;}\n.fjb-wc-avatar{width:36px;height:36px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:14px;color:#fff;font-weight:600;overflow:hidden;}\n.fjb-wc-self-av{background:#7BB4F0;}\n.fjb-wc-bubble-wrap{max-width:70%;display:flex;flex-direction:column;}\n.fjb-wc-line.self{flex-direction:row-reverse;}\n.fjb-wc-line.self .fjb-wc-bubble-wrap{align-items:flex-end;}\n.fjb-wc-line.self .fjb-wc-avatar{margin-left:8px;}\n.fjb-wc-line.self .fjb-wc-sender{display:none;}\n.fjb-wc-line.self .fjb-wc-bubble{background:#95EC69;color:#191919;border-top-right-radius:0;}\n.fjb-wc-line.self .fjb-wc-time{text-align:right;margin:0 4px 2px 0;}\n.fjb-wc-line.other .fjb-wc-bubble-wrap{align-items:flex-start;}\n.fjb-wc-line.other .fjb-wc-avatar{margin-right:8px;}\n.fjb-wc-line.other .fjb-wc-bubble{background:#fff;color:#191919;border-top-left-radius:0;margin-left:8px;}\n.fjb-wc-sender{font-size:12px;color:#999;margin:0 0 2px 4px;}\n.fjb-wc-time{font-size:10px;color:#999;margin:0 0 2px 4px;}\n.fjb-wc-bubble{padding:8px 12px;border-radius:4px;line-height:1.5;word-break:break-word;position:relative;box-shadow:0 1px 1px rgba(0,0,0,0.06);white-space:normal;}\n.fjb-wc-bubble::before{content:'';position:absolute;top:10px;width:0;height:0;border:6px solid transparent;}\n.fjb-wc-line.self .fjb-wc-bubble::before{right:-6px;border-left-color:#95EC69;border-right:0;}\n.fjb-wc-line.other .fjb-wc-bubble::before{left:-6px;border-right-color:#fff;border-left:0;}\n.fjb-wc-at{color:#576B95;font-weight:500;}\n.fjb-wc-quote{border-left:4px solid #B0B0B0;background:#F0F0F0;padding:4px 8px;margin:0 0 4px 0;font-size:12px;color:#666;border-radius:0 4px 4px 0;line-height:1.4;}\n.fjb-wc-quote-meta{color:#576B95;}\n.fjb-wc-chip{display:inline-block;background:#F0F0F0;border-radius:4px;padding:2px 6px;font-size:12px;color:#666;margin:0 2px;}\n</style>\n<div class=\"fjb-wc-container\" data-wc-mode=\"group\">\n<div class=\"fjb-wc-header\">$1</div>\n<div class=\"fjb-wc-body\">$2</div>\n</div>\n<script>\n(function(){\n  var cs=document.querySelectorAll('.fjb-wc-container[data-wc-mode=\"group\"]:not([data-wc-done])');\n  for(var i=0;i<cs.length;i++){\n    var c=cs[i];\n    var body=c.querySelector('.fjb-wc-body');\n    if(!body) continue;\n    var raw=body.textContent||'';\n    var lines=raw.split(/\\r?\\n/);\n    var out='';\n    for(var j=0;j<lines.length;j++){\n      var line=lines[j].replace(/^\\s+|\\s+$/g,'');\n      if(!line) continue;\n      out+=parseLine(line);\n    }\n    body.innerHTML=out;\n    body.style.whiteSpace='normal';\n    c.setAttribute('data-wc-done','1');\n  }\n  function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}\n  function parseLine(line){\n    var m;\n    if(m=line.match(/^\\[系统\\]\\s*(.+)$/)){return sys(m[1]);}\n    if(m=line.match(/^(?:\\[(\\d{1,2}:\\d{2})\\]\\s+)?\\[引用\\s+(\\S+)\\s+(\\d{1,2}:\\d{2})\\]\\s+([^:]+?)\\s*:\\s*(.+)$/)){return lineHtml(m[4],m[5],m[1],m[2]+' '+m[3]);}\n    if(m=line.match(/^\\[(\\d{1,2}:\\d{2})\\]\\s+([^:]+?)\\s*:\\s*(.+)$/)){return lineHtml(m[2],m[3],m[1],null);}\n    return sys(line);\n  }\n  function sys(t){return '<div class=\"fjb-wc-line sys\"><span class=\"fjb-wc-sys-text\">'+esc(t)+'</span></div>';}\n  function enh(t){\n    var e=esc(t);\n    e=e.replace(/@([^\\s@，。、！？：；]+)/g,'<span class=\"fjb-wc-at\">@$1</span>');\n    e=e.replace(/\\[图片\\]/g,'<span class=\"fjb-wc-chip\">🖼 图片</span>');\n    e=e.replace(/\\[语音\\]/g,'<span class=\"fjb-wc-chip\">🎤 语音消息</span>');\n    e=e.replace(/\\[视频\\]/g,'<span class=\"fjb-wc-chip\">🎥 视频消息</span>');\n    e=e.replace(/\\[表情\\]/g,'<span class=\"fjb-wc-chip\">😊</span>');\n    return e;\n  }\n  function lineHtml(who,content,time,quote){\n    var self=(who.replace(/^\\s+|\\s+$/g,''))==='我';\n    var cls=self?'self':'other';\n    var av=self?'<div class=\"fjb-wc-avatar fjb-wc-self-av\">我</div>':avatar(who);\n    var nameStr=self?'':'<div class=\"fjb-wc-sender\">'+esc(who)+'</div>';\n    var timeStr=time?'<div class=\"fjb-wc-time\">'+esc(time)+'</div>':'';\n    var quoteStr=quote?'<div class=\"fjb-wc-quote\"><span class=\"fjb-wc-quote-meta\">引用 '+esc(quote)+'</span></div>':'';\n    return '<div class=\"fjb-wc-line '+cls+'\">'+av+'<div class=\"fjb-wc-bubble-wrap\">'+timeStr+nameStr+'<div class=\"fjb-wc-bubble\">'+quoteStr+enh(content)+'</div></div></div>';\n  }\n  function avatar(name){\n    var ch=(name||'?').charAt(0);\n    var cols=['#FA7268','#7E57C2','#42A5F5','#26A69A','#FFA726','#8D6E63','#66BB6A','#EC407A','#5C6BC0','#26C6DA'];\n    var idx=0;for(var i=0;i<name.length;i++){idx+=name.charCodeAt(i);}idx=idx%cols.length;\n    return '<div class=\"fjb-wc-avatar\" style=\"background:'+cols[idx]+'\">'+esc(ch)+'</div>';\n  }\n})();\n</script>",
  "trimStrings": [],
  "placement": [2],
  "disabled": false,
  "markdownOnly": true,
  "promptOnly": false,
  "runOnEdit": true,
  "substituteRegex": 0,
  "minDepth": null,
  "maxDepth": null
}
